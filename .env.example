# =============================================================================
# CrediFlux SaaS - Variables de entorno
# Copia este archivo a .env.local (desarrollo) y configúralo en Vercel
# (Production, Preview y Development). NUNCA commitees valores reales.
# =============================================================================

PORT=3000
NODE_ENV=development

# --- Supabase (REQUERIDO) -----------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca exponer en el cliente (omite RLS).
# Requerido para "Vaciar Datos del Sistema" (llama a la RPC SECURITY DEFINER).
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> Database (conexión directa/pooler). Respaldo atómico de
# la purga mediante Prisma $transaction cuando la RPC aún no está aplicada.
DATABASE_URL=
DIRECT_URL=

# Checklist "Vaciar Datos del Sistema" (mismo valor en .env.local y Vercel:
# Production/Preview/Development):
#   1) NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY
#   2) SUPABASE_SERVICE_ROLE_KEY
#   3) Aplicar las migraciones de supabase/migrations/ con `supabase db push --remote`
#   4) Opcional pero recomendado: DATABASE_URL (pooler) como respaldo transaccional
#   5) Reiniciar `npm run dev` tras editar .env.local; redeploy en Vercel

# --- Supabase CLI (opcional, solo para aplicar migraciones desde CI/local) ----
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- Bootstrap de datos legados ----------------------------------------------
# Contraseña temporal para el administrador al importar data/crediflux-store.json.
# Cámbiala inmediatamente después del primer login.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Almacenamiento de archivos -------------------------------------------------
# Vercel Blob para comprobantes en producción. Si no se define, se guardan en
# public/uploads (solo desarrollo local).
BLOB_READ_WRITE_TOKEN=

# --- Claves de Inteligencia Artificial / OCR -----------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OCRSPACE_API_KEY=

# Clave para cifrar secretos sensibles guardados en Supabase (AES-256-GCM).
# OBLIGATORIA en producción. Acepta 64 chars hex, 32 bytes base64 o passphrase.
SETTINGS_ENCRYPTION_KEY=

# Secreto exclusivo del servidor para firmar las cookies cf_session_start /
# cf_last_activity (HMAC-SHA256). OBLIGATORIO en producción; si se omite se usa
# SETTINGS_ENCRYPTION_KEY. Nunca usar la anon key ni un valor público.
SESSION_SIGNING_SECRET=

# Identificador de tenant legado (compatibilidad; Supabase usa user_id + RLS).
DEFAULT_TENANT_ID=default
