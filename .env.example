# Configuración del Entorno - CrediFlux SaaS
PORT=3000
NODE_ENV=development

# --- Persistencia (REQUERIDO en Vercel / producción) ---
# PostgreSQL administrado (Vercel Postgres, Neon, Supabase, etc.)
# DATABASE_URL: conexión usada en runtime (puede ser pooler)
DATABASE_URL=
# DIRECT_URL: conexión directa para migraciones Prisma (recomendado si usas pooler)
DIRECT_URL=

# --- Almacenamiento de archivos (patrones de comprobantes / uploads) ---
# Si está definido, los archivos se suben a Vercel Blob (persistente en Vercel)
# Si no, en desarrollo local se guardan en public/uploads (no usar en Vercel)
BLOB_READ_WRITE_TOKEN=

# --- Claves de Inteligencia Artificial / OCR (secretos, nunca commitear valores reales) ---
# También pueden gestionarse desde Ajustes; si se guardan en DB deben cifrarse con SETTINGS_ENCRYPTION_KEY.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OCRSPACE_API_KEY=

# Clave para cifrar secretos sensibles guardados en base de datos (OBLIGATORIA en producción)
# Usada para cifrado AES-256-GCM en reposo de claves de proveedores IA/OCR.
# Acepta: 64 chars hex, 32 bytes en base64, o una passphrase robusta (se deriva internamente).
SETTINGS_ENCRYPTION_KEY=

# Opcional: identificador de tenant por defecto (instalación single-tenant)
DEFAULT_TENANT_ID=default

